---
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import Sugitora from '../components/Sugitora.astro';
import WorkCard from '../components/WorkCard.astro';
import Cta from '../components/Cta.astro';
import { site } from '../config/site';
import { services, flow, faqs, supports } from '../data/content';
import { getAllBlogs, getAllWorks, formatDate } from '../lib/microcms';

const blogs = (await getAllBlogs()).slice(0, 3);
const works = (await getAllWorks()).slice(0, 6);
const topFaqs = faqs.filter((f) => f.top);
---
<Base transparentHeader>
  <!-- 1. ファーストビュー -->
  <section class="hero">
    <div class="hero__img">
      <Picture name="car-red-coupe" alt="" sizes="100vw" loading="eager" fetchpriority="high" decoding="sync" />
    </div>
    <div class="hero__inner container">
      <h1 class="hero__copy">あなたに合う一台を、<br />一緒に。</h1>
    </div>
  </section>

  <!-- 2. 最新情報 -->
  <section class="news section--alt">
    <div class="container news__inner">
      <div class="news__head">
        <span class="news__en" aria-hidden="true">NEWS</span>
        <h2 class="news__ja">最新情報</h2>
      </div>
      <div class="news__body">
        {blogs.length ? (
          <ul class="news__list">
            {blogs.map((b) => (
              <li>
                <a href={`/blog/${b.id}/`} class="news__item">
                  <time class="date" datetime={b.publishedAt}>{formatDate(b.publishedAt)}</time>
                  {b.category && <span class="tag">{b.category}</span>}
                  <span class="news__title">{b.title}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="note">現在お知らせはありません。</p>
        )}
        <a class="more news__more" href="/blog/">MORE <span class="more__circle"><Icon name="arrow" /></span></a>
      </div>
    </div>
  </section>

  <!-- 3. TRYS MOTORSについて -->
  <section class="section about">
    <div class="container about__inner">
      <div class="about__text reveal">
        <SectionHead en="ABOUT" ja="町田で、店舗を持たずに。<br />だから無駄のない価格で。" />
        <p>TRYS MOTORS（トライスモータース）は、町田を拠点に中古車・バイクの販売と買取を行う小さな車屋です。一般的な販売店と違い店舗を構えず、その分の経費を省いて価格に反映しています。</p>
        <p>大切にしているのは、お客様との信頼関係。国家二級整備士が一台一台を細かく点検し、問題のある車は販売しません。ご要望をじっくり伺い、一緒に最適な一台を考えます。</p>
        <a class="more mt-24" href="/about/">MORE <span class="more__circle"><Icon name="arrow" /></span></a>
      </div>
      <div class="about__visual reveal">
        <Picture name="shop-container-kei" alt="TRYS MOTORSのコンテナ前に停まる軽自動車" sizes="(max-width: 900px) 100vw, 560px" class="about__photo" />
        <div class="about__mascot"><Sugitora variant="omakase" size={190} /></div>
      </div>
    </div>
  </section>

  <!-- 4. サービス -->
  <section class="section section--alt service">
    <div class="container">
      <SectionHead en="SERVICE" ja="販売・買取から、その後のメンテナンスまで" lead="中古車・バイクの販売と買取を中心に、購入後のメンテナンスや車検代行まで対応しています。" />
      <ul class="service__list">
        {services.map((s) => (
          <li class="service__item reveal">
            <a href={`/service/#${s.id}`} class="service__link">
              <div class="service__img"><Picture name={s.image} alt="" sizes="(max-width: 900px) 100vw, 580px" /></div>
              <div class="service__body">
                <span class="service__en" aria-hidden="true">{s.en}</span>
                <h3 class="service__title">{s.title}</h3>
                <p class="service__lead">{s.lead}</p>
                <span class="more">MORE <span class="more__circle"><Icon name="arrow" /></span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. 在庫車一覧への導線 -->
  <section class="stock">
    <div class="stock__bg"><Picture name="car-blue-suv" alt="" sizes="(max-width: 900px) 100vw, 700px" class="stock__car" /></div>
    <div class="container stock__inner">
      <div class="stock__text reveal">
        <span class="stock__en" aria-hidden="true">STOCK CAR</span>
        <h2 class="stock__ja">在庫車一覧</h2>
        <p>現在販売中の在庫は、カーセンサーの店舗ページでご覧いただけます。気になる一台があれば、掲載ページを見たうえでお気軽にご連絡ください。在庫にない車種もお探しできます。</p>
        <a class="btn btn--primary btn--lg" href={site.links.stock} target="_blank" rel="noopener">カーセンサーで在庫車を見る<Icon name="external" class="btn__ext" /></a>
        <p class="stock__note">※ 外部サイト（カーセンサー）が開きます</p>
      </div>
    </div>
  </section>

  <!-- 6. 購入後のサポート -->
  <section class="section support">
    <div class="container">
      <SectionHead en="SUPPORT" ja="売って終わりにしない。<br />購入後のカーライフもサポートします" center />
      <ul class="support__list">
        {supports.map((s) => (
          <li class="support__item reveal">
            <Icon name="check" class="support__icon" />
            <div>
              <h3 class="support__title">{s.title}</h3>
              <p class="support__text">{s.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="note center mt-24">※ 自社保証は、事故や故意による故障を除き、現車確認をしていただいたお客様が対象です。詳しい条件はお問い合わせください。</p>
    </div>
  </section>

  <!-- 7. 売買実績 -->
  <section class="section section--alt works">
    <div class="container">
      <div class="works__head">
        <SectionHead en="WORKS" ja="売買実績" lead="これまでに販売・買取をさせていただいたお車の一部をご紹介します。" class="works__sec-head" />
        <a class="more works__more" href="/works/">MORE <span class="more__circle"><Icon name="arrow" /></span></a>
      </div>
      {works.length ? (
        <ul class="grid grid--3">
          {works.map((w) => <li class="reveal"><WorkCard work={w} /></li>)}
        </ul>
      ) : (
        <div class="empty"><p>実績は準備中です。</p></div>
      )}
      <p class="note mt-24">※ 売買実績は過去の事例です。現在販売中のお車は<a class="text-brand" href={site.links.stock} target="_blank" rel="noopener">在庫車一覧</a>をご覧ください。</p>
    </div>
  </section>

  <!-- 8. ご相談から納車まで -->
  <section class="section flow">
    <div class="container">
      <div class="flow__head">
        <SectionHead en="FLOW" ja="ご相談から納車までの流れ" lead="初めての方にも分かりやすいよう、実際の進め方に沿ってご案内します。" />
        <div class="flow__mascot"><Sugitora variant="okiniiri" size={170} /></div>
      </div>
      <ol class="flow__list">
        {flow.map((f) => (
          <li class="flow__item reveal">
            <span class="flow__step" aria-hidden="true">{f.step}</span>
            <h3 class="flow__title">{f.title}</h3>
            <p class="flow__text">{f.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 9. よくある質問 -->
  <section class="section section--alt faq-top">
    <div class="container faq-top__inner">
      <div class="faq-top__side">
        <SectionHead en="FAQ" ja="よくある質問" />
        <Sugitora variant="peace" size={150} class="faq-top__mascot" />
        <a class="more" href="/faq/">MORE <span class="more__circle"><Icon name="arrow" /></span></a>
      </div>
      <div class="faq-top__list">
        {topFaqs.map((f, i) => (
          <details class="faq" open={i === 0 ? true : undefined}>
            <summary class="faq__q"><span class="faq__mark">Q</span><span>{f.q}</span><Icon name="chevron" class="faq__chev" /></summary>
            <div class="faq__a"><span class="faq__mark faq__mark--a">A</span><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. アクセス・相談案内 -->
  <section class="section access">
    <div class="container access__inner">
      <div class="access__text reveal">
        <SectionHead en="ACCESS" ja="アクセス・ご来店について" />
        <table class="info-table">
          <tbody>
            <tr><th>店名</th><td>{site.name}（{site.nameJa}）</td></tr>
            <tr><th>所在地</th><td>{site.address.full}</td></tr>
            <tr><th>電話番号</th><td><a class="text-brand" href={site.telHref}>{site.tel}</a></td></tr>
            <tr><th>営業時間</th><td>{site.hours}（{site.hoursNote}）</td></tr>
          </tbody>
        </table>
        <p class="note note--box mt-24">{site.visitNote}</p>
        <a class="more mt-24" href="/access/">MORE <span class="more__circle"><Icon name="arrow" /></span></a>
      </div>
      <div class="access__map reveal">
        <iframe src={site.mapEmbedUrl} title="TRYS MOTORS 所在地の地図" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  /* ヒーロー */
  .hero { position: relative; min-height: min(88vh, 860px); display: flex; align-items: center; color: var(--c-white); background: var(--c-dark); overflow: hidden; }
  .hero__img { position: absolute; inset: 0; }
  .hero__img :global(picture) { height: 100%; }
  .hero__img :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 60% 55%; }
  .hero__img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.72) 0%, rgba(0,0,0,.25) 45%, rgba(0,0,0,.12) 70%, rgba(0,0,0,.5) 100%); }
  .hero__inner { position: relative; padding-block: clamp(120px, 14vw, 160px) clamp(80px, 10vw, 120px); }
  .hero__copy { font-size: clamp(36px, 6.4vw, 80px); line-height: 1.25; letter-spacing: .04em; font-weight: 900; text-shadow: 0 2px 24px rgba(0,0,0,.35); }
  @media (max-width: 768px) {
    .hero { min-height: 92svh; }
    .hero__inner { padding-bottom: 64px; }
      .hero__copy { font-size: clamp(28px, 8.4vw, 34px); letter-spacing: .02em; }
    .hero__img :global(img) { object-position: 62% 50%; }
  }

  /* NEWS（BUDDICA と同様にリスト型） */
  .news { padding-block: clamp(36px, 4vw, 56px); }
  .news__inner { display: grid; grid-template-columns: 200px 1fr; gap: 32px; align-items: start; }
  .news__en { font-family: var(--ff-en); font-weight: 700; font-size: clamp(28px, 3vw, 40px); line-height: 1; letter-spacing: .04em; display: block; }
  .news__ja { font-size: 14px; font-weight: 500; color: var(--c-text-sub); margin-top: 6px; }
  .news__list li + li { border-top: 1px solid var(--c-line); }
  .news__item { display: grid; grid-template-columns: auto auto 1fr; align-items: center; gap: 16px; padding: 14px 4px; }
  .news__item:hover .news__title { color: var(--c-brand-dark); text-decoration: underline; text-underline-offset: 4px; }
  .news__title { font-size: 15px; font-weight: 500; line-height: 1.6; }
  .news__more { margin-top: 20px; }
  @media (max-width: 768px) {
    .news__inner { grid-template-columns: 1fr; gap: 16px; }
    .news__item { grid-template-columns: auto auto; }
    .news__title { grid-column: 1 / -1; }
  }

  /* ABOUT */
  .about__inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .about__text p { color: var(--c-text-sub); }
  .about__visual { position: relative; }
  .about__visual :global(.about__photo) { border-radius: var(--radius-lg); width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .about__mascot { position: absolute; right: -12px; bottom: -30px; }
  @media (max-width: 900px) {
    .about__inner { grid-template-columns: 1fr; }
    .about__visual { order: -1; margin-bottom: 24px; }
    .about__mascot { right: 4px; bottom: -20px; }
    .about__mascot :global(.sugitora) { width: 120px !important; }
  }

  /* SERVICE：写真＋文章の左右分割を交互に */
  .service__list { display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px); }
  .service__link { display: grid; grid-template-columns: 1.1fr 1fr; background: var(--c-white); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--c-line); transition: border-color .2s; }
  .service__link:hover { border-color: var(--c-brand); color: inherit; }
  .service__link:hover .service__img :global(img) { transform: scale(1.03); }
  .service__item:nth-child(even) .service__link { grid-template-columns: 1fr 1.1fr; }
  .service__item:nth-child(even) .service__img { order: 2; }
  .service__img { aspect-ratio: 16 / 10; overflow: hidden; background: var(--c-bg-alt); }
  .service__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .service__body { padding: clamp(24px, 3.5vw, 48px); display: flex; flex-direction: column; justify-content: center; }
  .service__en { font-family: var(--ff-en); font-weight: 700; font-size: 13px; letter-spacing: .14em; color: var(--c-brand); }
  .service__title { font-size: clamp(22px, 2.4vw, 30px); margin-top: 6px; }
  .service__lead { color: var(--c-text-sub); margin: 12px 0 20px; font-size: 15px; }
  @media (max-width: 900px) {
    .service__link, .service__item:nth-child(even) .service__link { grid-template-columns: 1fr; }
    .service__item:nth-child(even) .service__img { order: 0; }
  }

  /* STOCK：暗い背景に大きな車の切り抜き */
  .stock { position: relative; background: var(--c-dark); color: var(--c-white); overflow: hidden; padding-block: clamp(64px, 8vw, 120px); }
  .stock__bg { position: absolute; right: max(24px, calc((100% - var(--container)) / 2)); top: 50%; transform: translateY(-50%); width: min(46%, 640px); opacity: .95; pointer-events: none; }
  .stock__inner { position: relative; }
  .stock__text { max-width: 480px; }
  .stock__text p { color: rgba(255,255,255,.85); margin-bottom: 24px; }
  .stock__en { font-family: var(--ff-en); font-weight: 700; letter-spacing: .14em; color: var(--c-brand); font-size: 14px; }
  .stock__en::before { content: ''; display: inline-block; width: 28px; height: 3px; background: var(--c-brand); vertical-align: middle; margin-right: 12px; }
  .stock__ja { font-size: clamp(30px, 4vw, 48px); margin: 8px 0 16px; }
  .stock__note { font-size: 12px !important; margin-top: 12px !important; color: rgba(255,255,255,.65) !important; }
  @media (max-width: 900px) {
    .stock { padding-top: 40px; }
    .stock__bg { position: static; transform: none; width: min(100%, 560px); margin: 0 auto 8px; }
    .stock__text .btn { width: 100%; }
  }

  /* SUPPORT */
  .support__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px 32px; }
  .support__item { display: flex; gap: 14px; padding: 22px 0; border-top: 2px solid var(--c-line); }
  :global(.support__icon) { width: 24px; height: 24px; flex: none; color: var(--c-brand); margin-top: 3px; }
  .support__title { font-size: 17px; }
  .support__text { font-size: 14px; color: var(--c-text-sub); margin-top: 4px; }
  @media (max-width: 900px) { .support__list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .support__list { grid-template-columns: 1fr; gap: 0; } }

  /* WORKS */
  .works__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .works__more { margin-bottom: clamp(32px, 4vw, 56px); flex: none; }
  @media (max-width: 560px) { .works__head { flex-direction: column; align-items: flex-start; } .works__more { margin: -16px 0 24px; } }

  /* FLOW */
  .flow__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
  .flow__mascot { flex: none; margin-top: -8px; }
  .flow__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; counter-reset: step; }
  .flow__item { position: relative; padding: 28px 24px 26px; border: 1px solid var(--c-line); border-radius: var(--radius-lg); background: var(--c-white); }
  .flow__step { font-family: var(--ff-en); font-weight: 700; font-size: 28px; color: var(--c-brand); line-height: 1; letter-spacing: .04em; }
  .flow__title { font-size: 18px; margin-top: 10px; }
  .flow__text { font-size: 14px; color: var(--c-text-sub); margin-top: 8px; }
  @media (max-width: 900px) { .flow__list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) {
    .flow__list { grid-template-columns: 1fr; gap: 12px; }
    .flow__mascot :global(.sugitora) { width: 110px !important; }
    .flow__item { display: grid; grid-template-columns: auto 1fr; column-gap: 16px; padding: 20px; }
    .flow__step { grid-row: 1 / 3; }
    .flow__title { margin-top: 0; }
  }

  /* FAQ（トップ抜粋） */
  .faq-top__inner { display: grid; grid-template-columns: 280px 1fr; gap: 48px; align-items: start; }
  .faq-top__side :global(.faq-top__mascot) { margin-bottom: 24px; }
  @media (max-width: 900px) {
    .faq-top__inner { grid-template-columns: 1fr; gap: 16px; }
    .faq-top__side { display: grid; grid-template-columns: 1fr auto; align-items: center; }
    .faq-top__side :global(.faq-top__mascot) { width: 96px !important; grid-row: 1 / 3; grid-column: 2; margin: 0; }
  }

  /* ACCESS */
  .access__inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .access__map iframe { width: 100%; aspect-ratio: 4 / 3; border: 0; border-radius: var(--radius-lg); }
  @media (max-width: 900px) { .access__inner { grid-template-columns: 1fr; } }
</style>
