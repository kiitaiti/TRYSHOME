---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Loader from '@/components/Loader.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import Sugitora from '@/components/Sugitora.astro';
import Icon from '@/components/Icon.astro';
import WorkCard from '@/components/WorkCard.astro';
import NewsList from '@/components/NewsList.astro';
import CtaSection from '@/components/CtaSection.astro';
import BeforeAfter from '@/components/BeforeAfter.astro';
import { site } from '@/data/site';
import { reformCategories } from '@/data/reform';
import { flowSteps, features, faqs } from '@/data/content';
import { getWorks, getNews, imgUrl } from '@/lib/microcms';
import heroLiving from '@/assets/photos/hero-living.jpg';
import heroDining from '@/assets/photos/hero-dining.jpg';
import heroKitchen from '@/assets/photos/hero-kitchen.jpg';
import ceoPhoto from '@/assets/img/ceo.jpg';

const works = await getWorks();
const featured = works.filter((w) => w.featured).slice(0, 6);
const topWorks = featured.length >= 3 ? featured : works.slice(0, 6);
const baWork = works.find((w) => w.beforeImage && w.afterImage);
const news = (await getNews()).slice(0, 3);
const heroSlides = [
  { src: heroLiving, alt: '明るいリビングダイニング' },
  { src: heroDining, alt: '白を基調としたダイニング' },
  { src: heroKitchen, alt: '対面キッチン' },
];
---

<BaseLayout isHome description={site.description}>
  <!-- 1. ファーストビュー（スライドショー） -->
  <section class="hero" aria-label="メインビジュアル">
    <div class="hero__slides" aria-hidden="true">
      {
        heroSlides.map((sl, i) => (
          <Image
            class="hero__slide"
            src={sl.src}
            alt=""
            width={1920}
            height={1080}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            style={`animation-delay:${i * 6}s`}
          />
        ))
      }
    </div>
    <div class="hero__inner">
      <h1 class="hero__title">住まいが変わる。<br />毎日が変わる。</h1>
      <p class="sr-only">住まいのリフォーム、TRYS HOMEにお任せ。東京都町田市のリフォーム会社です。</p>
    </div>
    <div class="hero__sugi">
      <Sugitora pose="peace" width={300} loading="eager" float />
    </div>
  </section>

  <!-- 2. 住まいのお悩み・リフォームメニュー -->
  <section class="section menu" aria-labelledby="menu-title">
    <div class="container">
      <div class="menu__head reveal">
        <SectionTitle en="REFORM MENU" ja="リフォームメニュー" id="menu-title" />
      </div>
      <p class="lead reveal">「ここが古くなってきた」「使いにくい」<br class="sp" />——<span class="em">相談したい場所</span>から選べます</p>
      <ul class="menu__grid">
        {
          reformCategories.map((c, i) => (
            <li class="reveal" style={`transition-delay:${i * 60}ms`}>
              <a class="menu-card" href={`/reform/${c.slug}/`}>
                <div class="menu-card__img">
                  <Image src={c.photo} alt={c.photoAlt} width={520} height={360} loading={i < 3 ? 'eager' : 'lazy'} />
                </div>
                <div class="menu-card__body">
                  <span class="menu-card__icon"><Icon name={c.icon} /></span>
                  <span class="menu-card__name">{c.name}</span>
                  <span class="menu-card__lead">{c.lead}</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="note text-center" style="margin-top:20px">
        上記以外の工事や「どこに頼めばいいか分からない」というご相談も承ります。新築のご相談も可能です。
      </p>
    </div>
  </section>

  <!-- 3. 施工実績 -->
  <section class="section bg-gray works" aria-labelledby="works-title">
    <div class="container">
      <div class="works__head reveal">
        <SectionTitle en="WORKS" ja="施工実績" id="works-title" />
      </div>
      <p class="lead reveal">TRYS HOMEが手がけた<span class="em">実際の施工写真</span>をご紹介します</p>
      <div class="works__grid-wrap">
        <div class="works__sugi"><Sugitora pose="kirei" width={200} /></div>
      <div class="grid grid--3 works__grid">
        {topWorks.map((w, i) => <div class="reveal" style={`transition-delay:${i * 60}ms`}><WorkCard work={w} /></div>)}
      </div>
      </div>
      {works.length === 0 && <p class="text-center note">施工実績は準備中です。</p>}
      <div class="btn-row">
        <a class="btn btn--outline" href="/works/">施工実績一覧はこちら<span class="arrow"></span></a>
      </div>
    </div>
  </section>

  {
    baWork && (
      <section class="section" aria-labelledby="ba-title">
        <div class="container">
          <h2 id="ba-title" class="sr-only">施工前後の変化</h2>
          <div class="reveal">
            <BeforeAfter
              before={{ src: imgUrl(baWork.beforeImage!, 800, { height: 600 }), width: 800, height: 600 }}
              after={{ src: imgUrl(baWork.afterImage!, 800, { height: 600 }), width: 800, height: 600 }}
              alt={baWork.title}
            />
            <p class="text-center" style="margin-top:16px">
              <a href={`/works/${baWork.id}/`} class="ba-link">{baWork.title} の詳細を見る ›</a>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <!-- 4. TRYS HOMEの特長 -->
  <section class="section bg-orange-pale reason" aria-labelledby="reason-title">
    <div class="container">
      <SectionTitle en="REASON" ja="TRYS HOMEが選ばれる理由" id="reason-title" />
      <div class="reason__wrap">
        <ol class="reason__list">
          {
            features.map((f, i) => (
              <li class="reason__item reveal" style={`transition-delay:${i * 80}ms`}>
                <span class="reason__num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="reason__title">{f.title}</h3>
                  <p class="reason__text">{f.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="reason__sugi">
          <Sugitora pose="peace" width={260} float />
          <p class="reason__bubble">職人の技術で<br />丁寧に仕上げます！</p>
        </div>
      </div>
      <div class="btn-row">
        <a class="btn btn--outline" href="/about/">選ばれる理由をくわしく<span class="arrow"></span></a>
      </div>
    </div>
  </section>

  <!-- 5. 相談から施工までの流れ -->
  <section class="section flow" aria-labelledby="flow-title">
    <div class="container">
      <div class="flow__head reveal">
        <SectionTitle en="FLOW" ja="ご相談から施工までの流れ" id="flow-title" />
        <div class="flow__sugi"><Sugitora pose="bow" width={130} alt="" /></div>
      </div>
      <ol class="flow__list">
        {
          flowSteps.map((s, i) => (
            <li class="flow__step reveal" style={`transition-delay:${i * 60}ms`}>
              <span class="flow__num">STEP {i + 1}</span>
              <h3 class="flow__title">{s.title}</h3>
              <p class="flow__text">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. 会社・代表の紹介 -->
  <section class="section bg-gray company" aria-labelledby="company-title">
    <div class="container company__inner">
      <div class="company__photo reveal">
        <Image src={ceoPhoto} alt={`${site.representative}`} width={720} height={543} loading="lazy" />
        <p class="company__name">{site.representative}</p>
      </div>
      <div class="company__body reveal">
        <SectionTitle en="COMPANY" ja="会社・代表のご紹介" id="company-title" align="left" />
        <p class="company__greeting">{site.greeting}</p>
        <dl class="company__dl">
          <div><dt>会社名</dt><dd>{site.corp}（{site.brand}）</dd></div>
          <div><dt>所在地</dt><dd>{site.postal} {site.address}</dd></div>
          <div><dt>建設業許可</dt><dd>{site.license}</dd></div>
          <div><dt>対応エリア</dt><dd>{site.serviceArea}</dd></div>
        </dl>
        <div class="btn-row" style="justify-content:flex-start">
          <a class="btn btn--outline" href="/company/">会社概要・代表挨拶<span class="arrow"></span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. お知らせ -->
  <section class="section-tight news" aria-labelledby="news-title">
    <div class="container news__inner">
      <SectionTitle en="NEWS" ja="お知らせ" id="news-title" align="left" />
      <div class="news__list">
        <NewsList items={news} />
        <p class="news__more"><a href="/news/">お知らせ一覧 ›</a></p>
      </div>
    </div>
  </section>

  <!-- SNS・LINE -->
  <section class="section sns" aria-labelledby="sns-title">
    <div class="container">
      <SectionTitle en="SNS" ja="LINE・SNSでもつながれます" id="sns-title" />
      <div class="sns__grid">
        <a class="sns-card sns-card--line reveal" href={site.line} target="_blank" rel="noopener">
          <span class="sns-card__icon"><Icon name="chat" /></span>
          <span class="sns-card__name">公式LINE</span>
          <span class="sns-card__text">LINEでもリフォームのご相談を受け付けています。写真を送って気軽に相談できます。</span>
          <span class="sns-card__btn">友だち追加してLINEで相談</span>
        </a>
        <a class="sns-card sns-card--insta reveal" href={site.instagram} target="_blank" rel="noopener" style="transition-delay:80ms">
          <span class="sns-card__icon"><Icon name="camera" /></span>
          <span class="sns-card__name">Instagram</span>
          <span class="sns-card__text">施工の様子や現場の写真を投稿しています。</span>
          <span class="sns-card__btn">{site.instagramId} を見る</span>
        </a>
        <a class="sns-card sns-card--tiktok reveal" href={site.tiktok} target="_blank" rel="noopener" style="transition-delay:160ms">
          <span class="sns-card__icon"><Icon name="music" /></span>
          <span class="sns-card__name">TikTok</span>
          <span class="sns-card__text">職人の仕事ぶりを動画で紹介しています。</span>
          <span class="sns-card__btn">{site.tiktokId} を見る</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 8. よくある質問 -->
  <section class="section bg-orange-light faq" aria-labelledby="faq-title">
    <div class="container">
      <SectionTitle en="FAQ" ja="よくあるご質問" id="faq-title" />
      <div class="faq__list">
        {
          faqs.map((f) => (
            <details class="faq__item reveal">
              <summary><span class="faq__q">Q</span>{f.q}</summary>
              <div class="faq__a"><span class="faq__a-mark">A</span><p>{f.a}</p></div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 9. お問い合わせ -->
  <CtaSection pose="wave" />

  <Loader slot="after-body" />
</BaseLayout>

<style>
  /* ---- hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--c-black);
    height: clamp(420px, 58vw, 640px);
    isolation: isolate;
  }
  .hero__slides {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: hero-fade 18s infinite;
  }
  @keyframes hero-fade {
    0% {
      opacity: 0;
      transform: scale(1.04);
    }
    6% {
      opacity: 1;
    }
    33% {
      opacity: 1;
      transform: scale(1);
    }
    40% {
      opacity: 0;
      transform: scale(1);
    }
    100% {
      opacity: 0;
    }
  }
  .hero__slides::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.18) 60%, rgba(0, 0, 0, 0.38) 100%);
  }
  .hero__inner {
    position: absolute;
    left: clamp(16px, 6vw, 96px);
    bottom: clamp(40px, 9vw, 110px);
    right: 16px;
  }
  .hero__title {
    color: #fff;
    font-size: clamp(34px, 6.4vw, 72px);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45), 0 0 2px rgba(0, 0, 0, 0.6);
  }
  .hero__sugi {
    position: absolute;
    right: clamp(8px, 4vw, 72px);
    bottom: 0;
    width: clamp(120px, 20vw, 260px);
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__slide {
      animation: none;
      opacity: 0;
    }
    .hero__slide:first-child {
      opacity: 1;
    }
  }
  @media (max-width: 600px) {
    .hero {
      height: 68vw;
      min-height: 380px;
    }
    .hero__inner {
      bottom: 28px;
      right: 30%;
    }
    .hero__title {
      font-size: 30px;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }
    .hero__sugi {
      width: 28vw;
      right: 6px;
    }
  }
  .pc {
    display: none;
  }
  .sp {
    display: inline;
  }
  @media (min-width: 768px) {
    .pc {
      display: inline;
    }
    .sp {
      display: none;
    }
  }

  /* ---- menu ---- */
  .menu__head,
  .works__head,
  .flow__head {
    position: relative;
  }
  .flow__sugi {
    position: absolute;
    right: 0;
    bottom: -8px;
    width: clamp(70px, 10vw, 120px);
  }
  /* スギトラは最初のカードの上に立ち、下半身はカードの裏に隠れる */
  .works__grid-wrap {
    position: relative;
    padding-top: clamp(70px, 9vw, 110px);
  }
  .works__sugi {
    position: absolute;
    left: clamp(8px, 3vw, 40px);
    top: 0;
    width: clamp(120px, 15vw, 190px);
    z-index: 0;
  }
  .works__grid {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 700px) {
    .flow__head {
      display: grid;
      justify-items: center;
    }
    .flow__sugi {
      position: static;
      width: 84px;
      margin: -16px 0 4px;
    }
    .works__grid-wrap {
      padding-top: 84px;
    }
    .works__sugi {
      width: 120px;
      left: 12px;
    }
  }
  .menu__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .menu-card {
    display: block;
    border: 1px solid var(--c-gray-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #fff;
    height: 100%;
    transition: transform 0.2s var(--ease), box-shadow 0.2s;
  }
  .menu-card:hover {
    opacity: 1;
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
  }
  .menu-card__img {
    aspect-ratio: 13 / 9;
    background: var(--c-orange-light);
    overflow: hidden;
  }
  .menu-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .menu-card__body {
    position: relative;
    padding: 30px 18px 18px;
    display: grid;
    gap: 6px;
  }
  .menu-card__icon {
    position: absolute;
    top: -24px;
    left: 16px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--c-orange);
    color: #fff;
    display: grid;
    place-items: center;
    box-shadow: 0 0 0 4px #fff;
  }
  .menu-card__icon svg {
    width: 26px;
    height: 26px;
  }
  .menu-card__name {
    font-weight: 700;
    font-size: 18px;
  }
  .menu-card__name::after {
    content: '›';
    color: var(--c-orange);
    margin-left: 8px;
  }
  .menu-card__lead {
    font-size: 14px;
    color: var(--c-muted);
    line-height: 1.6;
  }
  @media (max-width: 900px) {
    .menu__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }
    .menu-card__body {
      padding: 26px 12px 14px;
    }
    .menu-card__name {
      font-size: 15px;
    }
    .menu-card__lead {
      font-size: 12px;
    }
    .menu-card__icon {
      width: 40px;
      height: 40px;
      top: -20px;
      left: 10px;
    }
    .menu-card__icon svg {
      width: 22px;
      height: 22px;
    }
  }

  /* ---- works ---- */
  .ba-link {
    font-weight: 700;
    color: var(--c-orange-dark);
    text-decoration: underline;
  }

  /* ---- reason ---- */
  .reason__wrap {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  .reason__list {
    display: grid;
    gap: 16px;
  }
  .reason__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 20px 22px;
    border: 1px solid #f5dfc8;
  }
  .reason__num {
    font-family: var(--font-en);
    font-weight: 700;
    font-size: 30px;
    line-height: 1;
    color: var(--c-orange);
  }
  .reason__title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.5;
  }
  .reason__text {
    font-size: 14px;
    margin-top: 6px;
  }
  .reason__sugi {
    position: relative;
    width: clamp(170px, 26vw, 260px);
    margin-inline: auto;
  }
  .reason__bubble {
    position: absolute;
    left: -10px;
    top: -6px;
    background: #fff;
    border: 2px solid var(--c-orange);
    border-radius: 16px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.5;
    white-space: nowrap;
    transform: translateX(-30%);
  }
  .reason__bubble::after {
    content: '';
    position: absolute;
    right: 14px;
    bottom: -9px;
    border: 8px solid transparent;
    border-top-color: var(--c-orange);
    border-bottom: 0;
  }
  @media (min-width: 900px) {
    .reason__wrap {
      grid-template-columns: 1fr auto;
      gap: 48px;
    }
    .reason__bubble {
      transform: none;
      left: auto;
      right: 70%;
      top: 8px;
    }
  }
  @media (max-width: 899px) {
    .reason__sugi {
      margin-top: 28px;
    }
    .reason__bubble {
      left: 50%;
      transform: translateX(-120%);
    }
  }

  /* ---- flow ---- */
  .flow__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    counter-reset: step;
  }
  .flow__step {
    position: relative;
    background: #fff;
    border: 1px solid var(--c-gray-line);
    border-top: 4px solid var(--c-orange);
    border-radius: var(--radius);
    padding: 18px 18px 20px;
  }
  .flow__num {
    display: inline-block;
    font-family: var(--font-en);
    font-weight: 700;
    color: var(--c-orange);
    font-size: 13px;
    letter-spacing: 0.1em;
  }
  .flow__title {
    font-size: 17px;
    font-weight: 700;
    margin-top: 4px;
  }
  .flow__text {
    font-size: 14px;
    color: var(--c-muted);
    margin-top: 6px;
  }
  @media (max-width: 900px) {
    .flow__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
  @media (max-width: 520px) {
    .flow__list {
      grid-template-columns: 1fr;
    }
  }

  /* ---- company ---- */
  .company__inner {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  .company__photo img {
    border-radius: var(--radius-lg);
    width: 100%;
    height: auto;
  }
  .company__name {
    margin-top: 10px;
    font-weight: 700;
    text-align: center;
  }
  .company__greeting {
    font-size: 15px;
  }
  .company__dl {
    margin-top: 18px;
    border-top: 1px solid var(--c-gray-line);
    font-size: 14px;
  }
  .company__dl > div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid var(--c-gray-line);
  }
  .company__dl dt {
    font-weight: 700;
    color: var(--c-orange-dark);
  }
  @media (min-width: 768px) {
    .company__inner {
      grid-template-columns: 1fr 1.3fr;
      gap: 48px;
    }
  }

  /* ---- news ---- */
  .news {
    padding-block: clamp(40px, 6vw, 72px);
  }
  .news__inner {
    display: grid;
    gap: 16px;
  }
  .news__more {
    text-align: right;
    margin-top: 12px;
    font-weight: 700;
  }
  .news__more a {
    color: var(--c-orange-dark);
    text-decoration: underline;
  }
  @media (min-width: 900px) {
    .news__inner {
      grid-template-columns: 240px 1fr;
      gap: 40px;
    }
  }

  /* ---- sns ---- */
  .sns__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .sns-card {
    display: grid;
    gap: 10px;
    justify-items: center;
    text-align: center;
    padding: 28px 22px 26px;
    border-radius: var(--radius-lg);
    color: #fff;
    transition: transform 0.2s var(--ease);
  }
  .sns-card:hover {
    opacity: 1;
    transform: translateY(-3px);
  }
  .sns-card--line {
    background: #06c755;
  }
  .sns-card--insta {
    background: #d6338f;
  }
