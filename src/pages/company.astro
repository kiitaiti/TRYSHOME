---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHero from '@/components/PageHero.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import Sugitora from '@/components/Sugitora.astro';
import CtaSection from '@/components/CtaSection.astro';
import { site } from '@/data/site';
import ceo from '@/assets/img/ceo.jpg';
import corpLogo from '@/assets/img/logo-trys-corp.png';
import photoRoof from '@/assets/photos/photo-roof.jpg';
const mapQuery = encodeURIComponent(`${site.address} 株式会社TRYS`);
---
<BaseLayout title="会社概要・代表挨拶" description={`${site.corp}（${site.brand}）の会社概要・代表挨拶。所在地：${site.address}。${site.license}。`}>
  <PageHero title="会社概要・代表挨拶" en="COMPANY" image={photoRoof} />
  <Breadcrumb items={[{ label: '会社概要' }]} />
  <section class="section">
    <div class="container">
      <SectionTitle en="GREETING" ja="代表挨拶" />
      <div class="greeting">
        <figure class="greeting__photo">
          <Image src={ceo} alt={site.representative} width={760} height={574} loading="eager" />
          <figcaption>{site.representative}</figcaption>
        </figure>
        <div class="greeting__body">
          <p class="greeting__text">{site.greeting}</p>
          <p class="greeting__sign">{site.corp}<br /><strong>{site.representative}</strong></p>
          <p class="greeting__strength"><span>当社の強み</span>{site.strengthText}</p>
        </div>
      </div>
    </div>
  </section>
  <section class="section bg-gray">
    <div class="container">
      <SectionTitle en="COMPANY" ja="会社概要" />
      <div class="company">
        <dl class="dl-table">
          <div><dt>社名</dt><dd>{site.corp}（{site.corpReading}）<br /><span class="note">リフォーム・住まいのご相談ブランド：{site.brand}</span></dd></div>
          <div><dt>所在地</dt><dd>{site.postal} {site.address}</dd></div>
          <div><dt>電話番号</dt><dd><a href={site.telHref}>{site.tel}</a></dd></div>
          <div><dt>FAX番号</dt><dd>{site.fax}</dd></div>
          <div><dt>代表者</dt><dd>{site.representative}</dd></div>
          <div><dt>設立</dt><dd>{site.established}</dd></div>
          <div><dt>資本金</dt><dd>{site.capital}</dd></div>
          <div><dt>許認可</dt><dd>{site.license}</dd></div>
          <div><dt>従業員数</dt><dd>{site.employees}</dd></div>
          <div><dt>事業内容</dt><dd><ul class="list">{site.business.map((b) => <li>{b}</li>)}</ul></dd></div>
          <div><dt>対応エリア</dt><dd>{site.serviceArea}</dd></div>
          <div><dt>主要取引銀行</dt><dd>{site.banks.join('、')}</dd></div>
          <div><dt>主要取引先</dt><dd>{site.clients.join('、')}</dd></div>
          <div><dt>所属加盟団体</dt><dd><ul class="list">{site.memberships.map((m) => <li>{m}</li>)}</ul></dd></div>
          <div><dt>インボイス番号</dt><dd>{site.invoice}</dd></div>
          <div><dt>Instagram</dt><dd><a href={site.instagram} target="_blank" rel="noopener" style="text-decoration:underline">{site.instagramId}</a></dd></div>
        </dl>
        <div class="company__side">
          <Image src={corpLogo} alt={`${site.corp} ロゴ`} width={320} densities={[1, 2]} loading="lazy" />
          <div class="company__sugi"><Sugitora pose="peace" width={190} /></div>
        </div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionTitle en="HISTORY" ja="沿革" />
      <ol class="history">
        {site.history.map((h) => <li><span class="history__year">{h.year}</span><span>{h.text}</span></li>)}
      </ol>
    </div>
  </section>
  <section class="section bg-gray">
    <div class="container">
      <SectionTitle en="ACCESS" ja="アクセス" />
      <p class="text-center" style="margin-bottom:20px">{site.postal} {site.address}</p>
      <div class="map">
        <iframe title="株式会社TRYS 所在地の地図" src={`https://www.google.com/maps?q=${mapQuery}&output=embed&hl=ja`} width="1100" height="420" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>
    </div>
  </section>
  <CtaSection pose="wave" />
</BaseLayout>
<style>
  .greeting { display: grid; gap: 24px; align-items: start; max-width: 1000px; margin-inline: auto; }
  .greeting__photo img { width: 100%; height: auto; border-radius: var(--radius-lg); }
  .greeting__photo figcaption { text-align: center; font-weight: 700; margin-top: 10px; }
  .greeting__text { font-size: 16px; line-height: 2; }
  .greeting__text + .greeting__text { margin-top: 16px; }
  .greeting__sign { margin-top: 24px; text-align: right; line-height: 1.6; }
  .greeting__sign strong { font-size: 18px; }
  .greeting__strength { margin-top: 24px; background: var(--c-orange-light); border-radius: var(--radius); padding: 14px 18px; font-size: 15px; }
  .greeting__strength span { display: block; font-weight: 700; color: var(--c-orange-dark); font-size: 13px; margin-bottom: 4px; }
  .company { display: grid; gap: 28px; align-items: start; }
  .company__side { display: grid; gap: 20px; justify-items: center; }
  .company__side img { width: 260px; height: auto; background: #fff; padding: 12px; border-radius: 8px; border: 1px solid var(--c-gray-line); }
  .company__sugi { width: 150px; }
  .list li { position: relative; padding-left: 14px; }
  .list li::before { content: '・'; position: absolute; left: 0; }
  .history { max-width: 720px; margin-inline: auto; display: grid; gap: 0; }
  .history li { display: grid; grid-template-columns: 140px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--c-gray-line); }
  .history__year { font-weight: 700; color: var(--c-orange-dark); }
  .map iframe { width: 100%; height: 420px; border: 0; border-radius: var(--radius-lg); display: block; }
  @media (min-width: 768px) { .greeting { grid-template-columns: 1fr 1.3fr; gap: 40px; } .company { grid-template-columns: 1fr 280px; gap: 40px; } }
  @media (max-width: 480px) { .history li { grid-template-columns: 1fr; gap: 2px; } }
</style>
