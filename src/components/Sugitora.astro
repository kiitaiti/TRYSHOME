---
/**
 * スギトラ配置コンポーネント。添付イラストをそのまま使用（トリミング・加工なし）。
 * pose: wave（手を振る） / fists（ガッツポーズ） / bow（お辞儀） / thumbs（グッド＋工具箱） /
 *       welcome（両手で案内） /
 *       kirei（welcome＋「めっちゃ綺麗やん！」吹き出し） / omakase（thumbs＋「TRYSにお任せ！」吹き出し）
 * 吹き出しは画像に含めず HTML で重ねる（文字の差し替えが容易・読み上げ可能）。
 */
import { Image } from 'astro:assets';
import wave from '@/assets/sugitora/sugitora-wave.png';
import fists from '@/assets/sugitora/sugitora-fists.png';
import bow from '@/assets/sugitora/sugitora-bow.png';
import thumbs from '@/assets/sugitora/sugitora-thumbs.png';
import welcome from '@/assets/sugitora/sugitora-welcome.png';

type Pose = 'wave' | 'fists' | 'bow' | 'thumbs' | 'welcome' | 'kirei' | 'omakase';
interface Props { pose: Pose; width?: number; class?: string; alt?: string; float?: boolean; loading?: 'lazy' | 'eager'; style?: string }
const { pose, width = 160, class: cls, alt, float = false, loading = 'lazy', style } = Astro.props;
const map: Record<Pose, { src: ImageMetadata; alt: string; bubble?: string }> = {
  wave: { src: wave, alt: 'スギトラが手を振っている' },
  fists: { src: fists, alt: 'スギトラがガッツポーズをしている' },
  bow: { src: bow, alt: 'スギトラがお辞儀をしている' },
  thumbs: { src: thumbs, alt: 'スギトラが工具箱を持ってグッドサインをしている' },
  welcome: { src: welcome, alt: 'スギトラが両手で案内している' },
  kirei: { src: welcome, alt: 'スギトラ「めっちゃ綺麗やん！」', bubble: 'めっちゃ<br>綺麗やん！' },
  omakase: { src: thumbs, alt: 'スギトラ「TRYSにお任せ！」', bubble: 'TRYS<br>にお任せ！' },
};
const { src, alt: defaultAlt, bubble } = map[pose];
const a = alt ?? defaultAlt;
---
<div
  class:list={['sugi', cls, { 'sugi--float': float, 'sugi--bubble': bubble }]}
  style={style}
  aria-hidden={a === '' ? 'true' : undefined}
>
  {bubble && <span class="sugi__bubble" aria-hidden="true" set:html={bubble} />}
  <Image src={src} alt={a} width={width} densities={[1, 2]} loading={loading} />
</div>
