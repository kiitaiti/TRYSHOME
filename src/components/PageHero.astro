---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { title: string; en?: string; image?: ImageMetadata; alt?: string }
const { title, en, image, alt = '' } = Astro.props;
---
<div class:list={['page-hero', { 'page-hero--plain': !image }]}>
  {image && <Image src={image} alt={alt} width={1600} height={400} loading="eager" fetchpriority="high" />}
  <h1>{title}{en && <small>{en}</small>}</h1>
</div>
