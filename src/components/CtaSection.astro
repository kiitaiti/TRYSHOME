---
import Sugitora from '@/components/Sugitora.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/data/site';
interface Props { pose?: 'omakase' | 'fists' | 'peace' | 'wave' }
const { pose = 'wave' } = Astro.props;
---
<section class="cta" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <div class="cta__sugi">
      <Sugitora pose={pose} width={260} float />
    </div>
    <div class="cta__body">
      <p class="cta__en">CONTACT</p>
      <h2 id="cta-title" class="cta__title">住まいのこと、まずはお気軽にご相談ください</h2>
      <p class="cta__text">
        「ここだけ直したい」「何から相談すればいいか分からない」という段階でも大丈夫です。<br class="pc" />
        お電話またはフォームからお問い合わせください。内容を確認のうえ、担当者よりご連絡いたします。
      </p>
      <div class="cta__actions">
        <a class="cta__tel" href={site.telHref}>
          <span class="cta__tel-label"><Icon name="phone" /> お電話でのご相談</span>
          <span class="cta__tel-number">{site.tel}</span>
        </a>
        <a class="btn btn--primary btn--lg" href="/contact/"><Icon name="mail" />ご相談・お見積りフォーム</a>
        <a class="btn btn--lg cta__line" href={site.line} target="_blank" rel="noopener"><Icon name="chat" />LINEで相談する</a>
      </div>
      <p class="cta__sns">
        SNSでも施工の様子を発信中：
        <a href={site.instagram} target="_blank" rel="noopener"><Icon name="camera" />Instagram {site.instagramId}</a>
        <a href={site.tiktok} target="_blank" rel="noopener"><Icon name="music" />TikTok {site.tiktokId}</a>
      </p>
    </div>
  </div>
</section>
<style>
  .cta {
    background: var(--c-orange);
    color: #fff;
    padding-block: clamp(40px, 6vw, 72px);
    position: relative;
    overflow: hidden;
  }
  .cta__inner {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  .cta__sugi {
    width: clamp(150px, 22vw, 240px);
    margin-inline: auto;
  }
  .cta__en {
    font-family: var(--font-en);
    font-weight: 700;
    letter-spacing: 0.2em;
    font-size: 14px;
    opacity: 0.9;
  }
  .cta__title {
    font-size: clamp(20px, 3vw, 28px);
    line-height: 1.5;
    margin-top: 6px;
  }
  .cta__text {
    margin-top: 14px;
    font-size: 15px;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    align-items: center;
    margin-top: 24px;
  }
  .cta__tel {
    display: grid;
    line-height: 1.3;
  }
  .cta__tel-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
  }
  .cta__tel-label svg {
    width: 18px;
    height: 18px;
  }
  .cta__tel-number {
    font-family: var(--font-en);
    font-size: clamp(30px, 4vw, 40px);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .cta .btn--primary {
    background: #fff;
    color: var(--c-orange-dark);
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.15);
  }
  .cta .btn--primary svg,
  .cta__line svg {
    width: 20px;
    height: 20px;
  }
  .cta__line {
    background: #06c755;
    color: #fff;
    box-shadow: 0 3px 0 rgba(0, 0, 0, 0.15);
  }
  .cta__sns {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin-top: 20px;
    font-size: 14px;
    font-weight: 700;
  }
  .cta__sns a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: underline;
  }
  .cta__sns svg {
    width: 18px;
    height: 18px;
  }
  .pc {
    display: none;
  }
  @media (min-width: 768px) {
    .cta__inner {
      grid-template-columns: auto 1fr;
      gap: 40px;
    }
    .pc {
      display: inline;
    }
  }
</style>
