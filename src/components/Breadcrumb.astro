---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="breadcrumb" aria-label="パンくずリスト">
  <div class="container">
    <ol>
      <li><a href="/">HOME</a></li>
      {items.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
    </ol>
  </div>
</nav>
