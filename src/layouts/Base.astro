---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../config/site';
import { isDemoMode } from '../lib/microcms';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** 追加の JSON-LD */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** ヒーローがヘッダー直下に来るページは true（ヘッダーを透過表示） */
  transparentHeader?: boolean;
}

const { title, description = site.description, ogImage, ogType = 'website', noindex = false, jsonLd, transparentHeader = false } = Astro.props;
const fullTitle = title ? `${title}｜${site.name} 町田の中古車販売・買取` : `${site.name}｜町田の中古車販売・買取・メンテナンス`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(ogImage ?? '/images/car-red-coupe-1200.webp', site.url).toString();

const business = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  name: site.name,
  alternateName: site.nameJa,
  url: site.url,
  telephone: '+81-42-714-1014',
  image: ogImageUrl,
  address: {
    '@type': 'PostalAddress',
    postalCode: site.address.postal,
    addressRegion: site.address.region,
    addressLocality: site.address.locality,
    streetAddress: site.address.street,
    addressCountry: 'JP',
  },
  openingHours: 'Mo-Su 09:00-18:00',
  sameAs: [site.links.x, site.links.youtube],
};
const ld = [business, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#d62828" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Poppins:wght@500;700&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {site.gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
        <script is:inline define:vars={{ gaId: site.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    {isDemoMode && <div class="demo-banner" role="note">仮公開中：ブログ・売買実績はサンプル表示です（microCMS 接続後に実際の記事へ置き換わります）</div>}
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      // スクロール時のフェードイン（prefers-reduced-motion では CSS 側で無効）
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if (items.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
